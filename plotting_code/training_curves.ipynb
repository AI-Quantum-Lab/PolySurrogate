   "source": [
    "# ============================================================\n",
    "# EXPLORATION: inspect a real training_history.npy directly\n",
    "# (checking whether we can plot straight from these instead of the\n",
    "# separate, stale plotting_code/Data/training_data/*.json exports)\n",
    "# ============================================================\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "inspect_path = Path(\n",
    "    \"/home/bo48god/projects/deep_dreaming/PolySurrogate_temp/\"\n",
    "    \"results/model_training/FNN/n4/n4_1/training_history.npy\"\n",
    ")\n",
    "\n",
    "history = np.load(inspect_path)\n",
    "print(\"file:\", inspect_path)\n",
    "print(\"dtype fields:\", history.dtype.names)\n",
    "print(\"array shape (== num_epochs cap, pre-allocated):\", history.shape)\n",
    "\n",
    "valid = history[history[\"epoch\"] >= 0]\n",
    "print(\"\\nvalid (actually-written) rows:\", len(valid))\n",
    "print(\"epoch range:\", valid[\"epoch\"].min(), \"-\", valid[\"epoch\"].max())\n",
    "\n",
    "print(\"\\nfirst row:\")\n",
    "print(valid[0])\n",
    "print(\"\\nlast row:\")\n",
    "print(valid[-1])\n",
    "\n",
    "print(\"\\npreview of key fields, every 4000th epoch:\")\n",
    "cols = [\"epoch\", \"train_loss\", \"validation_loss\", \"best_validation_loss\", \"best_epoch\", \"wait\"]\n",
    "for row in valid[::4000]:\n",
    "    print({c: row[c] for c in cols})\n",
    "print({c: valid[-1][c] for c in cols})\n"
   ]
  },
