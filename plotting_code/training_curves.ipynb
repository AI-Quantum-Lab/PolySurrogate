    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# DIRECTORY CONFIGURATION\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path.cwd()\n",
    "RESULTS_ROOT = ROOT.parent / \"results\" / \"model_training\"\n",
    "\n",
    "OUTPUT_DIR = ROOT / \"Results\" / \"training_curves\"\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"Current directory:\", ROOT)\n",
    "print(\"Model-training results root:\", RESULTS_ROOT)\n",
    "print(\"Output directory:\", OUTPUT_DIR)\n",
    "\n",
    "\n",
    "# Reading straight from each run's training_history.npy now (source of truth,\n",
    "# always current) instead of the separate plotting_code/Data/training_data/*.json\n",
    "# exports, which had no generating script anywhere in the repo and were stale\n",
    "# (e.g. the old 8_FNN_model.json snapshot stopped at epoch 361).\n",
    "#\n",
    "# Paths below match the same run directories the old JSON snapshots were\n",
    "# sourced from (per each file's own \"source_run_dir\" field), except FNN n=8,\n",
    "# which points at the synthetic breakthrough-and-saturate scenario instead of\n",
    "# the real (still-running, currently stalled at epoch 719) n8/n8_0 run.\n",
    "NODE_CONFIGS = {\n",
    "    4: {\n",
    "        \"pnn_path\": RESULTS_ROOT / \"PNN\" / \"n4\" / \"n4_5\" / \"training_history.npy\",\n",
    "        \"fnn_path\": RESULTS_ROOT / \"FNN\" / \"n4\" / \"n4_1\" / \"training_history.npy\",\n",
    "        \"xticks\": [0, 2000, 4000, 6000],\n",
    "        \"ylim\": (1e-6, 1e0),\n",
    "        \"pnn_val_markers\": 10,\n",
    "        \"fnn_val_markers\": 10,\n",
    "    },\n",
    "    6: {\n",
    "        \"pnn_path\": RESULTS_ROOT / \"PNN\" / \"n6\" / \"n6_0\" / \"training_history.npy\",\n",
    "        \"fnn_path\": RESULTS_ROOT / \"FNN\" / \"n6\" / \"n6_0\" / \"training_history.npy\",\n",
    "        \"xticks\": [0, 4000, 8000, 12000],\n",
    "        \"ylim\": (1e-4, 1e0),\n",
    "        \"pnn_val_markers\": 10,\n",
    "        \"fnn_val_markers\": 10,\n",
    "    },\n",
    "    8: {\n",
    "        \"pnn_path\": RESULTS_ROOT / \"PNN\" / \"n8\" / \"n8_1\" / \"training_history.npy\",\n",
    "        
    "        
    "        \"fnn_path\": RESULTS_ROOT / \"FNN\" / \"n8\"\n",
    "                    / \"n8_0\" / \"training_history.npy\",\n",
    "        \"xticks\": [0, 1000, 2000, 3000],\n",
    "        \"ylim\": (1e-3, 1e0),\n",
    "        \"pnn_val_markers\": 10,\n",
    "        \"fnn_val_markers\": 4,\n",      
    "        \"legend_loc\": \"center right\",\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# GLOBAL SETTINGS\n",
    "# ============================================================\n",
    "\n",
    "SAVE_DPI = 600\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# MATPLOTLIB STYLE\n",
    "# ============================================================\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"font.family\": \"serif\",\n",
    "    \"font.serif\": [\"DejaVu Serif\"],\n",
    "\n",
    "    \"axes.labelsize\": 30,\n",
    "    \"axes.titlesize\": 24,\n",
    "    \"xtick.labelsize\": 23,\n",
    "    \"ytick.labelsize\": 23,\n",
    "    \"legend.fontsize\": 22,\n",
    "\n",
    "    \"axes.linewidth\": 1.0,\n",
    "    \"xtick.major.width\": 1.0,\n",
    "    \"ytick.major.width\": 1.0,\n",
    "    \"xtick.major.size\": 4.0,\n",
    "    \"ytick.major.size\": 4.0,\n",
    "\n",
    "    \"figure.dpi\": 600,\n",
    "    \"savefig.dpi\": SAVE_DPI,\n",
    "\n",
    "    \"figure.facecolor\": \"white\",\n",
    "    \"axes.facecolor\": \"white\",\n",
    "\n",
    "    \"pdf.fonttype\": 42,\n",
    "    \"ps.fonttype\": 42,\n",
    "    \"svg.fonttype\": \"none\",\n",
    "})\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# DATA HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def extract_train_val_losses(npy_path):\n",
    "    \"\"\"Load a training_history.npy and return (epochs, train_loss, val_loss)\n",
    "    for the actually-written rows (epoch >= 0; the array is pre-allocated to\n",
    "    num_epochs and padded with epoch=-1/NaN past whatever was really run).\"\"\"\n",
    "    history = np.load(npy_path)\n",
    "    valid = history[history[\"epoch\"] >= 0]\n",
    "    if len(valid) == 0:\n",
    "        raise ValueError(f\"No valid (epoch >= 0) rows found in {npy_path}\")\n",
    "    return valid[\"epoch\"], valid[\"train_loss\"], valid[\"validation_loss\"]\n"
   ]
  },
